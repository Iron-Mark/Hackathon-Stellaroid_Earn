NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Fill in once your contract is deployed to testnet.
# Current public testnet contract (2026-06 security-hardened baseline): CAD6C24POQGRYXMBNBEGVDHUROF5ZC37XRDC6NCVILTXWMYJIBMISZCV
NEXT_PUBLIC_SOROBAN_CONTRACT_ID=

# Wallet address that controls admin-only trust actions such as approving or
# suspending issuers in the Phase 1 trust layer UI.
NEXT_PUBLIC_STELLAR_ADMIN_ADDRESS=

# A funded testnet account used only for simulating read-only contract calls.
# Fund any Stellar G... address at https://friendbot.stellar.org/
NEXT_PUBLIC_STELLAR_READ_ADDRESS=

NEXT_PUBLIC_SOROBAN_ASSET_ADDRESS=
NEXT_PUBLIC_SOROBAN_ASSET_CODE=XLM
NEXT_PUBLIC_SOROBAN_ASSET_DECIMALS=7

NEXT_PUBLIC_STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet

# WalletConnect (Reown) project id — enables the WalletConnect option, which
# reaches mobile wallets (LOBSTR, xBull, Hana, Freighter mobile). Public and
# safe to expose. Get one free at https://dashboard.reown.com and add your
# production + preview domains to the project's allowlist. When unset, the
# WalletConnect option is simply hidden from the wallet picker.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public canonical origin used by SEO metadata and internal URL validation.
# Keep this as your canonical production domain.
NEXT_PUBLIC_CANONICAL_URL=https://stellaroid.tech

# Public support/contact address. Rendered on /contact, /privacy, the pilot
# form, and in JSON-LD structured data. If unset it falls back to a personal
# address, so set it to your own before deploying.
NEXT_PUBLIC_CONTACT_EMAIL=

# Seeded demo-exhibit opportunity IDs for the wallet-less guided tour (/demo).
# Defaults match the currently-seeded exhibits; override on a reseed.
# See docs/operations/demo-exhibits.md.
# NEXT_PUBLIC_DEMO_OPPORTUNITY_RELEASED_ID=0
# NEXT_PUBLIC_DEMO_OPPORTUNITY_LIVE_ID=1

# Vercel sets VERCEL=1 automatically. For local analytics smoke tests only,
# set this to 1 to load Vercel Analytics outside Vercel.
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=0

# Fee sponsorship is disabled for public browser clients by default.
# Only enable for trusted server-to-server callers with a bearer token.
# FEE_SPONSOR_SECRET=S...
# FEE_SPONSOR_TOKEN=generate-a-long-random-server-token
# NEXT_PUBLIC_FEE_SPONSOR_ADDRESS=G...
# Optional fee-sponsor abuse ceilings (defaults are sensible):
# FEE_SPONSOR_MAX_REQUESTS_PER_MIN=
# FEE_SPONSOR_MAX_STROOPS_PER_MIN=

# Pilot lead capture (server-only). When these are set, /api/pilot-lead
# emails submissions via Resend; when unset, the endpoint returns 503 and the
# form falls back to its direct-contact links.
# RESEND_API_KEY=re_...
# LEAD_INBOX_EMAIL=you@example.com          # where pilot requests are delivered
# LEAD_FROM_EMAIL=onboarding@resend.dev     # verified Resend sender (has a default)

# Test harness only — do not set in production (gated by isE2EModeAllowed).
# NEXT_PUBLIC_E2E_MODE=0
